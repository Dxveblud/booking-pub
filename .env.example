# ---------------------------------------------------------------
# booking-template – variabili d'ambiente
# Copia questo file in ".env" e modifica i valori.
# ---------------------------------------------------------------

# Ambiente: development | production
NODE_ENV=development

# Porta HTTP (Render la imposta da solo)
PORT=3000

# Stringa di connessione MongoDB (locale o MongoDB Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/booking-template

# Segreto per firmare i cookie di sessione (stringa lunga e casuale).
# Generalo con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=cambia-questo-valore

# Credenziali del primo amministratore.
# Vengono usate SOLO all'avvio se nel database non esiste ancora nessun admin:
# la password viene salvata hashata (bcrypt). Dopo il primo avvio puoi toglierle.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=cambia-questa-password

# Domini autorizzati a incorporare il widget in un iframe (separati da spazio).
# "*" = qualunque sito. Esempio: https://www.barberiamario.it https://barberiamario.it
WIDGET_ALLOWED_ORIGINS=*

# Prenotazioni online consentite per indirizzo IP ogni 15 minuti (anti-spam)
BOOKING_RATE_LIMIT=10

# Percorso alternativo del file di configurazione dell'attività (opzionale)
# CONFIG_PATH=./config.json

