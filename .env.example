# ---------------------------------------------------------------
# booking-template – variabili d'ambiente
# Copia questo file in ".env" e modifica i valori.
# ---------------------------------------------------------------

# Ambiente: development | production
NODE_ENV=development

# Porta HTTP (Render la imposta da solo)
PORT=3000

# Stringa di connessione MongoDB (locale o MongoDB Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/booking-template

# Segreto per firmare i cookie di sessione (stringa lunga e casuale).
# Generalo con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=cambia-questo-valore

# Credenziali del primo amministratore.
# Vengono usate SOLO all'avvio se nel database non esiste ancora nessun admin:
# la password viene salvata hashata (bcrypt). Dopo il primo avvio puoi toglierle.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=cambia-questa-password

# Domini autorizzati a incorporare il widget in un iframe (separati da spazio).
# "*" = qualunque sito. Esempio: https://www.barberiamario.it https://barberiamario.it
WIDGET_ALLOWED_ORIGINS=*

# Prenotazioni online consentite per indirizzo IP ogni 15 minuti (anti-spam)
BOOKING_RATE_LIMIT=10

# Percorso alternativo del file di configurazione dell'attività (opzionale)
# CONFIG_PATH=./config.json

# Indirizzo pubblico del sito: serve per i link nelle email (disdetta,
# recupero password, calendario). Senza, le email partono senza link.
# PUBLIC_URL=https://booking.dxveblud.dev

# Email del super admin, per il recupero password (i titolari usano l'email del negozio)
# ADMIN_EMAIL=

# ---------------------------------------------------------------
# Email: avvisi al titolare, conferme/promemoria/disdette ai clienti, recupero password.
# Senza SMTP_HOST l'invio è spento. Porta 465 = TLS diretto, 587 = STARTTLS.
# ---------------------------------------------------------------
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM="Prenotazioni <noreply@tuodominio.it>"

# ---------------------------------------------------------------
# Backup notturno (deploy/backup.sh)
# ---------------------------------------------------------------
# BACKUP_DIR=/home/ubuntu/booking-backups
# BACKUP_KEEP_DAYS=14
# Copia anche fuori dalla VM con rclone (configuralo prima con `rclone config`)
# BACKUP_RCLONE_REMOTE=gdrive:booking-backups

# ---------------------------------------------------------------
# Predisposizioni future (non ancora implementate)
# ---------------------------------------------------------------
# NOTIFY_WHATSAPP_ENABLED=false
# WHATSAPP_API_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# GOOGLE_CALENDAR_ENABLED=false
# GOOGLE_CALENDAR_ID=
# GOOGLE_SERVICE_ACCOUNT_JSON=
